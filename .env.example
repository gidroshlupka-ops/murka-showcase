# Copy to .env and fill in. Never commit real keys.
LLM_KEY_1=
LLM_KEY_2=
LLM_KEY_3=

# Optional: grouped keys from the same provider project share a daily quota.
# The manager treats the first 8 characters as a group id — rotate prefixes
# if you need independent buckets.

# Voice service
RVC_F0_METHOD=rmvpe
RVC_PITCH=6
RVC_TARGET_F0=220
RVC_F0_FEMALE=175
RVC_INDEX_RATE=0.72
RVC_PROTECT=0.35
EDGE_TTS_VOICE=en-US-JennyNeural
MODEL_PATH=weights/model.pth
INDEX_PATH=weights/model.index
